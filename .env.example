# RestoFlow — ympäristömuuttujat
#
# Kopioi tämä tiedostoksi .env.local ja täytä arvot. Älä koskaan committaa
# .env.local-tiedostoa — se on .gitignoressa.
#
# NEXT_PUBLIC_-etuliitteellä varustetut muuttujat päätyvät sivun
# lähdekoodiin ja ovat julkisia. Salaisuus EI saa koskaan olla
# NEXT_PUBLIC_-muuttujassa.

# --- Supabase (pakolliset) -------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=

# Julkaistava avain (sb_publishable_...). Turvallinen selaimeen, koska
# se kunnioittaa RLS-politiikkoja.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Kuittien luku kuvasta -------------------------------------------------
#
# ILMAN TÄTÄ kuitit lisätään käsin: kuva tallentuu, mutta kenttiä ei
# lueta. Sovellus kertoo tämän käyttäjälle eikä teeskentele yrittäneensä.
#
# Kun avain on asetettu, kuitin kuva lähetetään palvelimelta mallille ja
# kentät esitäytetään. Jokainen kenttä on silti tarkistettavissa ennen
# tallennusta, ja epävarmat on merkitty.
#
# Hanki avain: https://console.anthropic.com/settings/keys
#
# EI NEXT_PUBLIC_-etuliitettä. Avain on salaisuus.
ANTHROPIC_API_KEY=

# Valinnainen. Oletus on claude-opus-5. Halvempi vaihtoehto: claude-sonnet-5.
RECEIPT_MODEL=

# --- Sovelluksen osoite ----------------------------------------------------
#
# Käytetään salasanan palautuslinkin rakentamiseen. Ilman tätä osoite
# päätellään pyynnön otsikoista, mikä riittää useimmiten.
NEXT_PUBLIC_SITE_URL=

# --- Facebook- ja Instagram-julkaisu ---------------------------------------
#
# ILMAN NÄITÄ lounaslistaa ei voi julkaista someen. Asetusnäkymä kertoo
# sen suoraan eikä näytä painiketta joka vie virheilmoitukseen.
#
# Meta-sovellus luodaan osoitteessa https://developers.facebook.com/apps
# ja siihen lisätään Facebook Login for Business. Julkaisu vaatii
# lisäksi Metan App Review'n oikeuksille pages_manage_posts ja
# instagram_content_publish — ennen sitä julkaisu toimii vain sivuille
# joihin sovelluksen kehittäjällä tai testaajalla on rooli.
#
# EI NEXT_PUBLIC_-etuliitettä kumpaankaan. Molemmat ovat salaisuuksia.
META_APP_ID=
META_APP_SECRET=

# Paluuosoite Metan kirjautumisesta. Tämän pitää olla MERKILLEEN sama
# kuin Meta-sovelluksen asetuksissa "Valid OAuth Redirect URIs".
# Tyhjänä päätellään NEXT_PUBLIC_SITE_URL:sta tai pyynnön otsikoista.
#
# Esimerkki: https://budet-app.vercel.app/api/meta/callback
META_REDIRECT_URI=

# Facebookin sivutokenin salausavain. Tokeni ei vanhene, joten se on
# avain ravintolan Facebook-sivuun niin kauan kuin se on tallessa —
# siksi se salataan ennen kantaan tuloa.
#
# Luo avain:  openssl rand -base64 32
#
# JOS TÄMÄ VAIHTUU, kaikki tallennetut yhteydet on yhdistettävä
# uudelleen: vanhoja tokeneita ei voi enää purkaa.
META_TOKEN_KEY=

# Valinnainen. Graph-rajapinnan versio, oletus v25.0. Meta julkaisee
# uuden version noin neljännesvuosittain ja vanhat poistuvat käytöstä.
META_GRAPH_VERSION=

# --- Varausvahvistukset sähköpostilla --------------------------------------
#
# ILMAN NÄITÄ varaus toimii normaalisti, mutta asiakas näkee
# peruutuslinkin vain kerran varauksen jälkeen. Kannassa on tunnuksesta
# vain tiiviste, joten suljetun välilehden jälkeen linkkiä ei voi
# palauttaa kukaan — asiakkaan ainoa keino perua on soittaa.
#
# Avain Resendin hallinnasta. EI NEXT_PUBLIC_-etuliitettä: tämä on
# salaisuus, joka luetaan vain lib/restoflow/email.ts:ssä.
RESEND_API_KEY=

# Lähettäjä muodossa: Ravintola <varaukset@omaverkkotunnus.fi>
#
# Verkkotunnus on varmistettava Resendissä ennen kuin lähetys toimii.
# Varmistamaton tunnus vastaa 403:lla eikä viesti lähde.
RESERVATION_EMAIL_FROM=
