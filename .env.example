# Verra — ympäristömuuttujat (§71)
#
# Kopioi tämä tiedostoksi .env.local ja täytä arvot. Älä koskaan committaa
# .env.local-tiedostoa — se on .gitignoressa.
#
# NEXT_PUBLIC_-etuliitteellä varustetut muuttujat lähetetään selaimeen.
# Salaisuudet EIVÄT saa koskaan olla NEXT_PUBLIC_-muuttujissa.

# --- Supabase (pakolliset) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Julkaistava avain (sb_publishable_... tai legacy anon-JWT). Turvallinen
# selaimeen, kunnioittaa RLS-politiikkoja.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salainen avain. Ohittaa RLS:n — vain palvelinpuolelle, ei koskaan selaimeen.
# Tarvitaan taustakäsittelyyn, integraatioiden salaisuuksiin ja Stripe-webhookiin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dokumenttipoiminta ----------------------------------------------------
# "mock" ajaa deterministisen demo-poimijan ilman verkkoa. Vaihda kun oikea
# tarjoaja on rekisteröity lib/services/ocr/index.ts:ssä.
OCR_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- EU VIES ---------------------------------------------------------------
# Mock-tarjoaja ei tarvitse tunnuksia eikä koskaan väitä tuntematonta
# tunnistetta kelvolliseksi.
VIES_PROVIDER=mock
VIES_API_URL=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Sähköpostivastaanotto -------------------------------------------------
EMAIL_INBOUND_DOMAIN=
EMAIL_PROVIDER_API_KEY=
EMAIL_WEBHOOK_SECRET=

# --- Sovellus --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
